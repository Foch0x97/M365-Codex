# ============================================================
# M365-Codex 环境变量示例
# 复制为 .env 后填写。仓库中【只允许】提交本示例文件。
# 严禁把任何真实 Token / 密码 / 账号信息写进仓库或镜像。
# ============================================================

# --- 必填 ---

# 主加密密钥：Base64 编码，解码后必须正好 32 字节（AES-256-GCM）。
# 没有默认值；缺失或格式错误时服务拒绝进入 ready 状态。
# 生成方式： node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
M365_CODEX_MASTER_KEY=

# 管理端登录密码（至少 12 位，建议使用密码管理器生成的随机串）。
M365_CODEX_ADMIN_PASSWORD=

# --- 可选 ---

# 服务监听端口，默认 8080
PORT=8080

# 数据目录（SQLite、上传文件），默认 /data；本地开发可设为 ./data
DATA_DIR=/data

# 对外 API Base URL，用于管理界面生成 Codex config.toml
PUBLIC_API_BASE_URL=

# 管理界面公开地址
PUBLIC_ADMIN_URL=

# 是否信任反向代理的 X-Forwarded-* 头（true/false），默认 false
TRUST_PROXY=false

# 日志隐私模式：strict（默认，最严格）/ metadata / debug
LOG_PRIVACY_MODE=strict

# 日志级别：fatal/error/warn/info/debug/trace，默认 info
LOG_LEVEL=info

# 上游 Sydney/BizChat WebSocket 基址（用于应对上游端点漂移，留空则使用内置默认配置）
# 默认 wss://substrate.office.com
UPSTREAM_WS_BASE=

# 上游连接路径模板，{oid}/{tid} 会被替换为账号的对象 ID 与租户 ID
# 默认 /m365Copilot/Chathub/{oid}@{tid}
UPSTREAM_PATH_TEMPLATE=
# 协议适配层版本，M0 探针校准真实协议后可切换。默认 sydney-json-v1
UPSTREAM_PROTOCOL_VERSION=
# 心跳间隔 / 握手超时 / 空闲超时（毫秒）与最大重连次数（同一账号内）
UPSTREAM_HEARTBEAT_INTERVAL_MS=15000
UPSTREAM_HANDSHAKE_TIMEOUT_MS=15000
UPSTREAM_IDLE_TIMEOUT_MS=60000
UPSTREAM_MAX_RECONNECTS=2

# --- 工具调用与代理循环（可选）---
# 工具目录交给上游的方式：
#   native —— 只在上游请求里带结构化工具声明
#   prompt —— 只用提示词约束上游输出 <tool_call>{…}</tool_call>
#   auto   —— 两者都上并都解析（默认；M0 探针确认上游能力前最稳妥）
TOOLS_MODE=auto
# 单轮最多接受的工具调用数，超出则如实报错，不擅自截断
TOOLS_MAX_CALLS_PER_ROUND=8
# 一条对话链上的最大工具轮次与累计工具调用数
TOOLS_MAX_ROUNDS=16
TOOLS_MAX_TOTAL_CALLS=64
# 单个工具结果的最大字节数，超出返回 413
TOOLS_MAX_RESULT_BYTES=262144
# 参数不合法时请求上游修复的次数，0-2（上限由协议规则固定为 2）
TOOLS_MAX_ARG_REPAIRS=2
# 是否允许一轮出现多个工具调用（请求里的 parallel_tool_calls 只能更严）
TOOLS_ALLOW_PARALLEL=true

# --- 文件 / 图片 / Office-PDF（M6，可选）---
# 单文件（含 Upload 单个分片）最大字节数，默认 26214400（25 MiB）
FILES_MAX_FILE_BYTES=26214400
# 单次 multipart 请求最大字节数，须 ≥ FILES_MAX_FILE_BYTES，默认 27262976（26 MiB）
FILES_MAX_REQUEST_BYTES=27262976
# 单个 API Key 累计存储上限，默认 209715200（200 MiB）
FILES_MAX_TOTAL_BYTES_PER_KEY=209715200
# 文件保留期（毫秒），超过后由清理任务回收；默认 30 天，0 表示不自动过期
FILES_RETENTION_MS=2592000000
# 未完成 Upload 的存活时间（毫秒），超过后视为过期并清理已收到的分片，默认 24 小时
FILES_UPLOAD_TTL_MS=86400000

# 上游是否真支持图片输入（input_image）。默认 false——真实能力要等 M0 探针校准，
# 为 false 时 input_image 返回明确的 unsupported_feature 错误，不假装支持
UPSTREAM_IMAGE_INPUT=false

# 重建的对话上下文超过多少字符就从最旧历史开始截断（Codex 等 store:false 客户端
# 每轮会带上几万字符的系统指令 + 完整历史）。默认 400000，给一个宽松值
CONTEXT_MAX_CHARS=400000

# 出口代理默认值（对上游与 OAuth 请求生效）
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# 主密钥版本号，用于密钥轮换，默认 1
MASTER_KEY_VERSION=1

# --- OAuth 上游参数（可选，留空使用内置默认值） ---
# 上游端点会漂移，这些全部做成配置项，不在代码里硬编码。

# 公共客户端 ID（PKCE 流程，非机密）
OAUTH_CLIENT_ID=
# 回调地址。默认使用 Microsoft 的 nativeclient 页面，
# 这样本服务不需要公网可达——用户登录后把回调地址粘回管理界面即可
OAUTH_REDIRECT_URI=
OAUTH_AUTHORIZE_URL=
OAUTH_TOKEN_URL=
# 空格或逗号分隔。默认：
#   https://substrate.office.com/sydney/M365Chat.Read
#   https://substrate.office.com/sydney/sydney.readwrite
#   offline_access openid profile
OAUTH_SCOPES=

# ============================================================
# 【禁止项】不要通过环境变量注入任何 Microsoft Token 或 OAuth 凭据。
# 这些凭据只能经 PKCE 授权流程获取，并以 AES-256-GCM 加密入库。
# 服务启动时会检测并拒绝以下变量名（示例，非完整列表）：
#   M365_ACCESS_TOKEN / M365_REFRESH_TOKEN
#   MICROSOFT_ACCESS_TOKEN / MICROSOFT_REFRESH_TOKEN
#   SUBSTRATE_ACCESS_TOKEN / SYDNEY_ACCESS_TOKEN / COPILOT_ACCESS_TOKEN
# ============================================================
