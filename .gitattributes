# 仓库内一律以 LF 存储，避免 Windows 开发机把 CRLF 带进容器与 CI 脚本
* text=auto eol=lf

# 明确指定：这些文件在容器/CI 中执行，CRLF 会直接导致失败
Dockerfile      text eol=lf
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# 二进制文件不做任何转换
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.woff          binary
*.woff2         binary
*.sqlite        binary
